# Producción (Hostinger): el proyecto vive dentro de public_html, así que todo
# se reenvía a public/ para que la URL no lleve /public/. Las URLs antiguas con
# /public/ siguen funcionando (el CLI de piezas las usa en su url_base).
Options -Indexes

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_URI} !/public/
	RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
	Require all denied
</IfModule>
